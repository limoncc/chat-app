{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for ChatApp main window (local toolbar). Remote site URLs are injected at runtime via sites-runtime capability.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "global-shortcut:default",
    "window-state:default"
  ]
}
